# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (matches docker-compose.yml's postgres service) ---
POSTGRES_USER=carelens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=carelens
POSTGRES_PORT=5432

# --- App (app/config.py) ---
ENVIRONMENT=development
DEBUG=true
ENABLED_MODULES=identity,residents,observations,audit,ai_gateway,summaries,handover

DATABASE_URL=postgresql+asyncpg://carelens:change-me@localhost:5432/carelens
REDIS_URL=redis://localhost:6379/0

OIDC_ISSUER=http://localhost:8080/realms/carelens
OIDC_CLIENT_ID=carelens-app
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=carelens-app

LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=

SENTRY_DSN=
LOG_LEVEL=INFO

CORS_ALLOWED_ORIGINS=http://localhost:5173
SECRET_KEY=change-me-in-env
