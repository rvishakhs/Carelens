# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (matches docker-compose.yml's postgres service) ---
POSTGRES_USER=carelens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=carelens
POSTGRES_PORT=5432

# --- App (app/config.py) ---
ENVIRONMENT=development
DEBUG=true
ENABLED_MODULES=identity,residents,floors,observations,care_recording,audit,ai_gateway,summaries,ai_insights,handover

DATABASE_URL=postgresql+asyncpg://carelens:change-me@localhost:5432/carelens
REDIS_URL=redis://localhost:6379/0

OIDC_ISSUER=http://localhost:8080/realms/CareLens
OIDC_CLIENT_ID=carelens-web
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=carelens-web

# --- Keycloak admin client (app/modules/identity/adapters/keycloak_admin.py) ---
# Confidential client with its service account granted realm-management's
# "manage-users" role -- used only to provision staff accounts, never for login.
# Realm/roles/clients are defined in keycloak/realm-export.json and auto-imported by
# docker-compose's keycloak service on first boot.
KEYCLOAK_SERVER=http://localhost:8080
KEYCLOAK_REALM=CareLens
KEYCLOAK_CLIENT_ID=carelens-api
KEYCLOAK_ADMIN_CLIENT_SECRET=

LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=

SENTRY_DSN=
LOG_LEVEL=INFO

CORS_ALLOWED_ORIGINS=http://localhost:5173
SECRET_KEY=change-me-in-env
