# Synthetic mode only. Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTELLIGENCE_DEMO_TOKEN=replace-with-a-random-local-token-at-least-24-characters
INTELLIGENCE_MODE=synthetic
INTELLIGENCE_PROVIDER=openai
INTELLIGENCE_HANDOVER_PROVIDER=openai
INTELLIGENCE_RESULT_TTL_SECONDS=900
INTELLIGENCE_MAX_RESULTS=100

# PGSQL DataBAse
INTELLIGENCE_DATABASE_URL=postgresql+psycopg://intelligence_app:APP_PASSWORD@127.0.0.1:5432/intelligence
INTELLIGENCE_MIGRATION_DATABASE_URL=postgresql+psycopg://intelligence_migrator:MIGRATION_PASSWORD@127.0.0.1:5432/intelligence


INTELLIGENCE_CLIENT_ID=
INTELLIGENCE_CLIENT_SECRET=
INTELLIGENCE_TOKEN_URL=
INTELLIGENCE_SERVICE_IDENTITY=

# Required for generation; keep the real key out of version control:
OPENAI_API_KEY=your-local-key
OPENAI_MODEL=gpt-6.1-sol
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_OUTPUT_TOKENS=4096
# Scheduled submission is opt-in. Uses INTELLIGENCE_DISPATCHER_TENANT_IDS and
# fresh CareLens handover:schedule grants; enabling can enqueue model work.
INTELLIGENCE_SCHEDULE_ENABLED=false
INTELLIGENCE_SCHEDULE_CATCH_UP_SHIFTS=4
